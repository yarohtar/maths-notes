{
  "name": "link-tweaks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render broken internal links as plain text and open links in a new tab. Must run after crawl-links.",
  "main": "./dist/index.js",
  "exports": { ".": { "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "quartz": {
    "name": "link-tweaks",
    "displayName": "Link tweaks",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 65,
    "defaultEnabled": true,
    "defaultOptions": { "brokenLinksAsText": true, "newTab": "all" }
  }
}
